// Keeps WiFi alive. If the connection drops it retries the current network
// for WIFI_TRY_MS, then switches to the next one, and keeps cycling.
void wifiMaintain() {
    unsigned long now = millis();

    if (WiFi.status() == WL_CONNECTED) {
        if (wifiTrying) {
            Serial.printf("WiFi connected to \"%s\". IP: ", WIFI_SSIDS[wifiIdx]);
            Serial.println(WiFi.localIP());
            wifiTrying = false;
        }
        return;
    }

    if (!wifiTrying) {
        wifiTrying = true;
        wifiAttemptStart = now;
        WiFi.disconnect();
        WiFi.begin(WIFI_SSIDS[wifiIdx], WIFI_PASSWORDS[wifiIdx]);
        Serial.printf("WiFi not connected. Trying \"%s\"...\n", WIFI_SSIDS[wifiIdx]);
        return;
    }

    if (now - wifiAttemptStart >= WIFI_TRY_MS) {
        wifiIdx = (wifiIdx + 1) % WIFI_COUNT;
        wifiAttemptStart = now;
        WiFi.disconnect();
        WiFi.begin(WIFI_SSIDS[wifiIdx], WIFI_PASSWORDS[wifiIdx]);
        Serial.printf("Switching to \"%s\"...\n", WIFI_SSIDS[wifiIdx]);
    }
}

// Once WiFi is up: start NTP, then keep trying Firebase sign-in every
// FB_RETRY_MS (5 s) until it works (covers offline boots and networks with no
// internet at first). Then clean the legacy nodes once.
void netMaintain() {
    if (WiFi.status() != WL_CONNECTED) return;

    unsigned long now = millis();

    if (!ntpConfigured) {
        configTime(0, 0, "pool.ntp.org", "time.nist.gov");   // UTC epoch
        ntpConfigured = true;
        Serial.println("NTP time sync started.");
    }

    if (!fbStarted && (lastFbTry == 0 || now - lastFbTry >= FB_RETRY_MS)) {
        lastFbTry = now;

        config.api_key = API_KEY;
        config.database_url = DATABASE_URL;

        if (Firebase.signUp(&config, &auth, "", "")) {
            Firebase.begin(&config, &auth);
            Firebase.reconnectWiFi(false);
            fbStarted = true;
            Serial.println("Firebase sign-in OK.");
        } else {
            Serial.printf("Firebase sign-in failed: %s (retrying)\n",
                          config.signer.signupError.message.c_str());
        }
    }

#if CLEAN_LEGACY_ON_BOOT
    if (fbStarted && !legacyCleaned && Firebase.ready()) {
        cleanLegacy();
        legacyCleaned = true;
    }
#endif
}

uint64_t nowEpochMs() {
    time_t t = time(nullptr);
    if (t < 1700000000) return 0;
    return (uint64_t) t * 1000ULL;
}

// Removes leftovers of the old 3-zone / 3-valve layout.
void cleanLegacy() {
    const char *old[] = {
            "/controls/zone2Command", "/controls/zone3Command",
            "/sensor/zone3",
            "/sensor/temperature", "/sensor/humidity", "/sensor/heatIndex",
            "/sensor/fanRunning", "/sensor/peltierRunning",
            "/sensor/pumpRunning", "/sensor/coolingRunning", "/sensor/fansRunning"
    };
    for (unsigned i = 0; i < sizeof(old) / sizeof(old[0]); i++)
