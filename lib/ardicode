// ============================================================
// SETUP  - nothing here waits for WiFi or Firebase
// ============================================================

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("========================================");
    Serial.println("  SMARTMIST ESP32-S3 - 2 ZONE COMPARISON");
    Serial.println("========================================");

    // everything OFF first
    digitalWrite(PUMP_RELAY, RELAY4_OFF);
    digitalWrite(FAN_RELAY, RELAY4_OFF);
    pinMode(PUMP_RELAY, OUTPUT);
    pinMode(FAN_RELAY, OUTPUT);
    digitalWrite(PUMP_RELAY, RELAY4_OFF);
    digitalWrite(FAN_RELAY, RELAY4_OFF);

    digitalWrite(PELTIER1_RELAY, PELT_OFF);
    digitalWrite(PELTIER2_RELAY, PELT_OFF);
    pinMode(PELTIER1_RELAY, OUTPUT);
    pinMode(PELTIER2_RELAY, OUTPUT);
    digitalWrite(PELTIER1_RELAY, PELT_OFF);
    digitalWrite(PELTIER2_RELAY, PELT_OFF);

    pinMode(FLOAT_PIN, INPUT_PULLUP);
#if FLOAT_FULL_PIN >= 0
    pinMode(FLOAT_FULL_PIN, INPUT_PULLUP);
#endif

    for (int i = 0; i < NZONES; i++) {
        dhts[i] = new DHT(DHT_PINS[i], DHT_TYPE);
        dhts[i]->begin();
    }
    waterSensor.begin();

    WiFi.mode(WIFI_STA);

    // initial readings so AUTO mode can act on the first loop pass
    readWaterLevel();
    readDHTs();
    readWaterTemperature();
    lastControlOk = millis();

    // Pump timing + Peltier/fan bursts run in their own task on core 0, so
    // slow WiFi/Firebase calls in loop() can never stretch the 15 s / 5 s timing.
    xTaskCreatePinnedToCore(outputTask, "outputs", 4096, NULL, 2, NULL, 0);

    // WiFi, time sync and Firebase sign-in are handled in loop()
    // by wifiMaintain() and netMaintain().

    Serial.println();
    Serial.println("SMARTMIST SYSTEM READY (network connecting in background)");
    Serial.println("========================================");
}


// ============================================================
// LOOP  - control never waits for WiFi/Firebase
// ============================================================

void loop() {
    unsigned long now = millis();

    wifiMaintain();
    netMaintain();

    // ---------------- FAST PATH (1 s) ----------------
    if (now - lastControlCheck >= CONTROL_INTERVAL) {
        lastControlCheck = now;

        readWaterLevel();

        if (fbStarted && Firebase.ready())
            readFastControls();

        controlSystem();
    }

    // ---------------- SLOW PATH (4 s) ----------------
    if (now - lastSensorSend >= SENSOR_INTERVAL) {
        lastSensorSend = now;

        readDHTs();
        readWaterTemperature();

        if (fbStarted && Firebase.ready()) {
            sendSensorData();
            flushLogs();
        }

        printSystemStatus();
    }
}


