const unsigned long FAN_RUNON_MS = 0;   // fans keep running this long after Peltiers stop

// Cooling while the pump is misting:
// 1 = the SAME thresholds apply whether the pump is running or not
//     (start at COOL_START_C, stop at COOL_STOP_C), so the pump, Peltiers and
//     fans can run together.
// 0 = pump has priority: Peltiers and fans never run while misting.
#define COOL_DURING_MIST 1

// Float switch debounce (the float is read once per second)
//   LOW_READS_IDLE    : pump NOT running -> tank counts as empty after this many
//                       low reads, so the pump is blocked from starting almost at once
//   LOW_READS_RUNNING : pump running -> needs this many low reads in a row before
//                       it is cut, so sloshing water does not stop it by mistake
#define LOW_READS_IDLE     1
#define LOW_READS_RUNNING  10

// MANUAL mode: 1 = stop misting if the device loses contact with Firebase
// for COMMS_TIMEOUT. 0 = keep the last command until contact returns.
#define MANUAL_STOP_ON_COMMS_LOSS 0

// 1 = when misting ends because the target heat index was reached, let the
// pump finish its current 15 s ON pulse instead of cutting it short.
// Safety stops (tank low, sensor fail, manual STOP) always cut it immediately.
#define PUMP_FINISH_PULSE 1


