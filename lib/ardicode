#endif

    Serial.println("Legacy Firebase nodes cleaned.");
}


// ============================================================
// SENSORS
// ============================================================

// Reads BOTH DHT22s back-to-back so zone 1 and zone 2 are in sync.
void readDHTs() {
    lastDhtRead = millis();

    for (int i = 0; i < NZONES; i++) {
        float h = dhts[i]->readHumidity();
        float t = dhts[i]->readTemperature();

        bool invalid = isnan(h) || isnan(t) ||
                       (h == 0.0 && t == 0.0) ||
                       h < 0.0 || h > 100.0 ||
                       t < -40.0 || t > 80.0;

        float hi = 0;
        if (!invalid) {
            hi = dhts[i]->computeHeatIndex(t, h, false);
            if (isnan(hi) || hi < -40.0 || hi > 90.0) invalid = true;
        }

        if (invalid) {
            zones[i].failCount++;
            zones[i].highCount = 0;

            if (zones[i].failCount >= DHT_MAX_FAILS) {
                zones[i].sensorOk = false;
                zones[i].temperature = 0;
                zones[i].humidity = 0;
                zones[i].heatIndex = 0;
            }
            continue;
        }

        zones[i].failCount = 0;
        zones[i].sensorOk = true;
        zones[i].temperature = t;
        zones[i].humidity = h;
        zones[i].heatIndex = hi;

        if (hi >= MIST_START_HI) zones[i].highCount++;
        else zones[i].highCount = 0;
    }
}

void readWaterTemperature() {
    waterSensor.requestTemperatures();
    float temp = waterSensor.getTempCByIndex(0);

    if (temp == DEVICE_DISCONNECTED_C || temp <= -100) {
        waterTemperature = -127;
        waterTemperatureCondition = "NO SENSOR";
        return;
    }

    waterTemperature = temp;
    waterTemperatureCondition = getWaterTemperatureCondition(temp);
}

String getWaterTemperatureCondition(float temp) {
    if (temp < 20.0) return "VERY COLD";
    if (temp < 25.0) return "COLD";
    if (temp < 30.0) return "WARM";
    return "HOT";
}

// Float switch: HIGH = water present, LOW = tank empty.
//  - water present  -> waterAvailable = true at once
//  - tank empty and pump idle    -> blocked after LOW_READS_IDLE read(s)
//  - tank empty and pump running -> cut after LOW_READS_RUNNING reads (anti-slosh)
void readWaterLevel() {
    bool high = (digitalRead(FLOAT_PIN) == HIGH);

    if (high) {
        waterAvailable = true;
        lowCount = 0;
    } else {
        if (lowCount < 255) lowCount++;

        int needed = (misting || pumpRunning) ? LOW_READS_RUNNING : LOW_READS_IDLE;
        if (lowCount >= needed) waterAvailable = false;
    }

#if FLOAT_FULL_PIN >= 0
    tankFull = (digitalRead(FLOAT_FULL_PIN) == HIGH);
#else
    tankFull = waterAvailable;
#endif

    static bool lastWA = true;
    if (waterAvailable != lastWA) {
        Serial.printf("WATER %s at %lu ms\n", waterAvailable ? "OK" : "LOW (pump blocked)",
                      millis());
        lastWA = waterAvailable;
    }
}


// ============================================================
// FIREBASE CONTROLS
// /controls/mode          "AUTO" | "MANUAL"
// /controls/zone1Command  "ON" | "OFF"   (MANUAL mode)
// ============================================================

void readFastControls() {
    if (!Firebase.RTDB.getJSON(&fbdo, "/controls"))
        return;

    FirebaseJson &json = fbdo.jsonObject();
    FirebaseJsonData d;

    if (json.get(d, "mode")) {
        systemMode = d.stringValue;
        systemMode.toUpperCase();
    }

    if (json.get(d, "zone1Command")) {
        mistCommand = d.stringValue;
        mistCommand.toUpperCase();
    }

    lastControlOk = millis();
}


// ============================================================
// CONTROL
// ============================================================

void controlSystem() {
    if (systemMode != lastMode) {
        if (misting) stopMist("MODE_CHANGE");
        lastMode = systemMode;
    }

    controlMisting();      // decides start/stop; outputs are handled by outputTask()
}

// Runs every 50 ms, independent of WiFi/Firebase.
void outputTask(void *param) {
    for (;;) {
        controlCooling();
        applyOutputs();
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

// Only zone 1 (the misted zone) decides. Zone 2 is just recorded.
void controlMisting() {
    Zone &z = zones[0];
    bool commsLost = (millis() - lastControlOk > COMMS_TIMEOUT);

    bool want = misting;
    const char *reason = "";

    if (!waterAvailable) {
        // empty tank: never start, and stop if running
        want = false;
        reason = "TANK_LOW";
    } else if (systemMode == "MANUAL") {
#if MANUAL_STOP_ON_COMMS_LOSS
        want = (!commsLost && mistCommand == "ON");
        reason = commsLost ? "COMMS_LOST" : "MANUAL_STOP";
#else
        want = (mistCommand == "ON");
        reason = "MANUAL_STOP";
#endif
    } else   // AUTO (works with or without WiFi)
    {
        if (!z.sensorOk) {
            want = false;
            reason = "SENSOR_FAIL";
        } else if (!misting && z.highCount >= 2)          // 2 good reads in a row (~8 s)
        {
            want = true;
        } else if (misting && z.heatIndex <= MIST_STOP_HI) {
            want = false;
            reason = "TARGET_REACHED";
        }
    }

    if (want && !misting) startMist();
    else if (!want && misting) stopMist(reason);
}

// Peltiers + fans: start at COOL_START_C, stop at COOL_STOP_C. The same rule
// applies during misting when COOL_DURING_MIST is 1 (see settings).
void controlCooling() {
    unsigned long now = millis();
    bool sensorGood = (waterTemperature > -100);

    if (now - coolWindowStart >= 24UL * 60UL * 60UL * 1000UL) {
        coolWindowStart = now;
        coolBudgetUsedMs = 0;
    }
    if (coolingRunning) coolBudgetUsedMs += (now - coolLastTick);
    coolLastTick = now;
    bool budgetLeft = (coolBudgetUsedMs < COOL_DAILY_BUDGET_MS);

    // With COOL_DURING_MIST = 1 the same start/stop thresholds are used whether
    // the pump is running or not. With 0, the pump always has priority.
    bool blockForMist = false;
#if !COOL_DURING_MIST
    blockForMist = (misting || pumpRunning);
#endif

    if (blockForMist || !waterAvailable || !sensorGood) {
        if (coolingRunning) {
            coolingRunning = false;
            coolRestUntil = now + COOL_REST_MS;
        }
        return;
    }

    if (coolingRunning) {
        if (waterTemperature <= COOL_STOP_C || !budgetLeft ||
            now - coolStartMs >= COOL_MAX_ON_MS) {
            coolingRunning = false;
            coolRestUntil = now + COOL_REST_MS;
        }
    } else {
        bool allowed = budgetLeft && (now >= coolRestUntil);

        if (allowed && waterTemperature >= COOL_START_C) {
            coolingRunning = true;
            coolStartMs = now;
        }
    }
}

// Pump pulses PUMP_ON_MS / PUMP_OFF_MS while misting.
// Peltiers (x2, 30 A relays) and the fan relay (K2, both fans) switch together.
// Runs inside outputTask(), so the timing stays exact.
void applyOutputs() {
    static bool cycling = false;
    static unsigned long phaseStart = 0;

    unsigned long now = millis();

    // after a normal stop, only the current ON pulse is finished
    if (!misting && pumpFinish && !pumpRunning) pumpFinish = false;

    // no water -> the pump is never allowed to run
    bool pumpWanted = waterAvailable && (misting || pumpFinish);

    if (!pumpWanted) {
        cycling = false;
        pumpRunning = false;
        pumpFinish = false;
    } else if (PUMP_CONTINUOUS) {
        pumpRunning = true;
    } else if (!cycling) {
        cycling = true;
        pumpRunning = true;
        phaseStart = now;
    } else if (pumpRunning && now - phaseStart >= PUMP_ON_MS) {
        pumpRunning = false;
        phaseStart = now;
        if (!misting) pumpFinish = false;     // last pulse finished
    } else if (!pumpRunning && now - phaseStart >= PUMP_OFF_MS) {
        pumpRunning = true;
        phaseStart = now;
    }

    digitalWrite(PUMP_RELAY, pumpRunning ? RELAY4_ON : RELAY4_OFF);

    if (coolingRunning) fanOffAt = now + FAN_RUNON_MS;
    fansRunning = coolingRunning || (now < fanOffAt);

    digitalWrite(PELTIER1_RELAY, coolingRunning ? PELT_ON : PELT_OFF);
    digitalWrite(PELTIER2_RELAY, coolingRunning ? PELT_ON : PELT_OFF);
    digitalWrite(FAN_RELAY, fansRunning ? RELAY4_ON : RELAY4_OFF);   // K2 on the 4-ch module
}

// ============================================================
// MIST LOG  (/logs/m_<epochSec>)
// ============================================================

Snap snapOf(int i) {
    Snap s;
    s.ok = zones[i].sensorOk;
    s.t = zones[i].temperature;
    s.h = zones[i].humidity;
    s.hi = zones[i].heatIndex;
    return s;
}

// Make sure both DHT22s were read just now, so the comparison
// values belong to the same moment.
void snapshotRefresh() {
    if (millis() - lastDhtRead > DHT_STALE_MS)
        readDHTs();
}

int allocLog() {
    for (int i = 0; i < MAX_LOGS; i++)
        if (logs[i].state == 0) return i;

    for (int i = 0; i < MAX_LOGS; i++)
        if (logs[i].state == 2) return i;

    return -1;
}

void startMist() {
    pumpFinish = false;
    misting = true;
    Serial.printf("startMist: log slot %d free=%s\n", allocLog(), allocLog() >= 0 ? "yes" : "NO");
    snapshotRefresh();

    Serial.printf(">> MIST START  zone1 HI %.1f | zone2 (control) HI %.1f\n",
                  zones[0].heatIndex, zones[1].heatIndex);

    int idx = allocLog();
    mistLogIdx = idx;
    if (idx < 0) return;

    LogEntry &e = logs[idx];
    e = LogEntry();
    e.state = 1;
    e.startedAt = nowEpochMs();
    e.startMs = millis();
    e.mistBefore = snapOf(0);
    e.ctrlBefore = snapOf(1);
    strncpy(e.mode, systemMode.c_str(), sizeof(e.mode) - 1);
}

void stopMist(const char *reason) {
#if PUMP_FINISH_PULSE
    // normal stop: let the pump finish its current ON pulse
    if (!PUMP_CONTINUOUS && pumpRunning && strcmp(reason, "TARGET_REACHED") == 0)
        pumpFinish = true;
#endif
    misting = false;
    snapshotRefresh();

    Serial.printf(">> MIST END (%s)  zone1 HI %.1f | zone2 (control) HI %.1f\n",
                  reason, zones[0].heatIndex, zones[1].heatIndex);

    if (mistLogIdx >= 0) {
        LogEntry &e = logs[mistLogIdx];

        if (e.state == 1) {
            e.state = 2;
            e.endedAt = nowEpochMs();
            e.endMs = millis();
            e.durationSec = (e.endMs - e.startMs) / 1000;
            e.mistAfter = snapOf(0);
            e.ctrlAfter = snapOf(1);
            strncpy(e.reason, reason, sizeof(e.reason) - 1);
        }
    }

    mistLogIdx = -1;
}

void addSnap(FirebaseJson &j, const String &prefix, const Snap &s) {
    if (!s.ok) return;
    j.set(prefix + "temperature", s.t);
    j.set(prefix + "humidity", s.h);
    j.set(prefix + "heatIndex", s.hi);
}

void flushLogs() {
    int budget = 3;

    for (int i = 0; i < MAX_LOGS && budget > 0; i++) {
        LogEntry &e = logs[i];
        if (e.state == 0) continue;
        if (e.state == 1 && e.startUploaded) continue;

        // clock was not synced when it happened -> rebuild timestamps now
        // clock was not synced when it happened -> rebuild timestamps now
        uint64_t n = nowEpochMs();
        if (n) {
            if (!e.startedAt) e.startedAt = n - (uint64_t)(millis() - e.startMs);
            if (e.state == 2 && !e.endedAt) e.endedAt = n - (uint64_t)(millis() - e.endMs);
        }

        if (e.key[0] == 0) {
            if (e.startedAt)
                snprintf(e.key, sizeof(e.key), "m_%lu", (unsigned long) (e.startedAt / 1000));
            else snprintf(e.key, sizeof(e.key), "m_u%lu", e.startMs);
        }

        FirebaseJson j;
        if (e.startedAt) j.set("startedAt", (double) e.startedAt);
        j.set("mode", e.mode);

        addSnap(j, "before/mist/", e.mistBefore);
        addSnap(j, "before/control/", e.ctrlBefore);

        if (e.state == 1) {
            j.set("status", "RUNNING");
        } else {
            if (e.endedAt) j.set("endedAt", (double) e.endedAt);
            j.set("durationSec", (double) e.durationSec);
            j.set("status", "DONE");
            j.set("stopReason", e.reason);

            addSnap(j, "after/mist/", e.mistAfter);
            addSnap(j, "after/control/", e.ctrlAfter);

            // comparison (only when all 4 readings are valid)
            if (e.mistBefore.ok && e.ctrlBefore.ok && e.mistAfter.ok && e.ctrlAfter.ok) {
                float mistDrop = e.mistBefore.hi - e.mistAfter.hi;   // + = cooled down
                float ctrlDrop = e.ctrlBefore.hi - e.ctrlAfter.hi;
                j.set("comparison/mistHeatIndexDrop", mistDrop);
                j.set("comparison/controlHeatIndexDrop", ctrlDrop);
                j.set("comparison/extraCoolingFromMist", mistDrop - ctrlDrop);
                j.set("comparison/heatIndexGapAfter", e.ctrlAfter.hi - e.mistAfter.hi);
            }
        }

        budget--;

        if (Firebase.RTDB.setJSON(&fbdo, String("/logs/") + e.key, &j)) {
            Serial.printf("LOG UPLOADED: %s (%s)\n", e.key, e.state == 2 ? "DONE" : "RUNNING");
            if (e.state == 2) e.state = 0;
            else e.startUploaded = true;
        } else {
            Serial.printf("LOG UPLOAD FAILED: %s -> %s\n", e.key, fbdo.errorReason().c_str());
            return;   // offline -> retry next pass
        }
    }
}

int pendingLogs() {
    int n = 0;
    for (int i = 0; i < MAX_LOGS; i++)
        if (logs[i].state == 2) n++;
    return n;
}


// ============================================================
// SEND LIVE DATA TO FIREBASE  (/sensor, /status)
// ============================================================

void sendSensorData() {
    FirebaseJson s;

    s.set("waterAvailable", waterAvailable);
    s.set("tankFull", tankFull);
    s.set("waterTemperature", waterTemperature);
    s.set("waterTemperatureCondition", waterTemperatureCondition);

    s.set("devices/pump", pumpRunning);
    s.set("devices/peltier1", coolingRunning);
    s.set("devices/peltier2", coolingRunning);
    s.set("devices/fan1", fansRunning);
    s.set("devices/fan2", fansRunning);

    s.set("systemOk", zones[0].sensorOk && (!ZONE2_INSTALLED || zones[1].sensorOk));

    // zone 1 = misted
    s.set("zone1/temperature", zones[0].temperature);
    s.set("zone1/humidity", zones[0].humidity);
    s.set("zone1/heatIndex", zones[0].heatIndex);
    s.set("zone1/sensorOk", zones[0].sensorOk);
    s.set("zone1/mistingStatus", misting ? "ON" : "OFF");

#if ZONE2_INSTALLED
    // zone 2 = control (no misting)
    s.set("zone2/temperature", zones[1].temperature);
    s.set("zone2/humidity", zones[1].humidity);
    s.set("zone2/heatIndex", zones[1].heatIndex);
    s.set("zone2/sensorOk", zones[1].sensorOk);

    if (zones[0].sensorOk && zones[1].sensorOk)
        s.set("heatIndexDiff", zones[1].heatIndex - zones[0].heatIndex);
#endif

    Firebase.RTDB.updateNode(&fbdo, "/sensor", &s);
    Firebase.RTDB.setTimestamp(&fbdo, "/sensor/lastUpdate");

    FirebaseJson st;
    st.set("activeMode", systemMode);
    st.set("zone2Installed", (bool) ZONE2_INSTALLED);
    st.set("wifi", WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED");
    st.set("thresholds/start", MIST_START_HI);
    st.set("thresholds/stop", MIST_STOP_HI);

    Firebase.RTDB.updateNode(&fbdo, "/status", &st);
}


// ============================================================
// SERIAL STATUS
// ============================================================

void printSystemStatus() {
    Serial.println();
    Serial.println("----------------------------------------");
    Serial.printf("Mode: %s  Tank: %s  Pump: %s  WiFi: %s  Firebase: %s  Pending logs: %d\n",
                  systemMode.c_str(),
                  waterAvailable ? "OK" : "LOW",
                  pumpRunning ? "ON" : "OFF",
                  WiFi.status() == WL_CONNECTED ? WIFI_SSIDS[wifiIdx] : "OFFLINE",
                  (fbStarted && Firebase.ready()) ? "READY" : "NOT READY",
                  pendingLogs());

    const char *names[2] = {"Zone 1 (MIST)   ", "Zone 2 (CONTROL)"};
    for (int i = 0; i < NZONES; i++) {
        if (zones[i].sensorOk)
            Serial.printf("%s: %.1fC  %.1f%%  HI %.1f%s\n",
                          names[i], zones[i].temperature, zones[i].humidity, zones[i].heatIndex,
                          i == 0 ? (misting ? "  mist ON" : "  mist OFF") : "");
        else
            Serial.printf("%s: SENSOR FAIL\n", names[i]);
    }

    if (waterTemperature > -100)
        Serial.printf("Water: %.2fC (%s)  Peltiers: %s  Fans: %s\n",
                      waterTemperature, waterTemperatureCondition.c_str(),
                      coolingRunning ? "ON" : "OFF",
                      fansRunning ? "ON" : "OFF");
    else
        Serial.println("Water: NO SENSOR  Peltiers: OFF  Fans: OFF");

    Serial.println("----------------------------------------");
}